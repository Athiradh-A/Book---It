@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600&family=Manrope:wght@500;600;700;800&display=swap');
:root{font-family:'DM Sans',sans-serif;color:#151716;background:#f4f0e7;font-synthesis:none;--blue:#1747ff;--ink:#151716;--cream:#f4f0e7;--coral:#ff6547}*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;min-width:320px;background:var(--cream)}button,input,select,textarea{font:inherit}a{color:inherit;text-decoration:none}:focus-visible{outline:3px solid #ff5c35;outline-offset:3px}.brand{display:inline-flex;align-items:center;font:800 1.05rem Manrope;letter-spacing:-.06em}.brand i{color:var(--blue);font-style:normal;margin:0 2px}.landing-nav,.topbar{display:flex;align-items:center;justify-content:space-between;padding:22px 4vw;position:relative;z-index:20}.landing-nav>div:last-child{display:flex;align-items:center;gap:22px}.pill,.primary{background:var(--ink);color:white;border:0;border-radius:999px;padding:13px 20px;display:inline-flex;gap:10px;align-items:center;justify-content:center;cursor:pointer;transition:.25s transform,.25s background}.pill:hover,.primary:hover{transform:translateY(-2px);background:var(--blue)}.text-link{font-size:.9rem}.hero{min-height:calc(100vh - 84px);padding:4vh 4vw 8vh;position:relative;overflow:hidden}.eyebrow,.kicker{font:600 .72rem Manrope;letter-spacing:.16em}.eyebrow{display:flex;justify-content:space-between;border-top:1px solid;padding-top:12px}.hero h1{font:800 clamp(4.5rem,13.2vw,12rem)/.76 Manrope;margin:8vh 0 3vh;letter-spacing:-.095em;position:relative;z-index:2}.hero h1 span{display:block}.hero h1 .accent-line{color:var(--blue);padding-left:13vw}.hero-copy{font-size:clamp(1rem,1.5vw,1.3rem);line-height:1.45;max-width:510px;margin-left:48vw}.hero-cta{position:absolute;left:4vw;bottom:8vh;border-bottom:1px solid;padding:12px 0;display:flex;gap:60px;font-weight:600}.orb{position:absolute;width:130px;height:130px;border-radius:45% 55% 60% 40%;display:grid;place-items:center;box-shadow:0 25px 80px #1747ff35;animation:float 6s ease-in-out infinite;z-index:3}.orb svg{width:42px;height:42px}.orb-a{right:10vw;top:17vh;background:#d7ff49;transform:rotate(12deg)}.orb-b{right:33vw;bottom:7vh;background:var(--coral);animation-delay:-2s}.grid-object{position:absolute;width:22vw;height:22vw;min-width:220px;min-height:220px;right:-5vw;bottom:-6vw;background:linear-gradient(135deg,#1747ff,#8da5ff);border-radius:32% 68% 54% 46%;transform:rotate(-16deg)}.reveal{animation:rise .8s cubic-bezier(.2,.8,.2,1) both}.delay-1{animation-delay:.08s}.delay-2{animation-delay:.16s}.delay-3{animation-delay:.25s}.categories{display:grid;grid-template-columns:repeat(3,1fr);padding:4vw;gap:14px;background:#101210}.category-card{min-height:470px;padding:28px;border-radius:26px;display:flex;flex-direction:column;transition:transform .35s}.category-card:hover{transform:translateY(-8px) rotate(-.5deg)}.category-card>span{font-size:.72rem}.category-card>svg{width:70px;height:70px;margin:auto}.category-card h2{font:700 clamp(1.8rem,3vw,3.4rem)/1 Manrope;letter-spacing:-.06em;margin:0}.category-card p{max-width:260px;line-height:1.5}.category-card>svg:last-child{width:24px;height:24px;margin:8px 0 0 auto}.cobalt{background:var(--blue);color:white}.ink{background:#262927;color:#f4f0e7}.coral{background:var(--coral)}.manifesto{padding:12vw 4vw;font:800 clamp(3rem,9vw,9rem)/.9 Manrope;letter-spacing:-.08em}.manifesto p{margin:0}.manifesto .outline{color:transparent;-webkit-text-stroke:2px var(--ink)}.manifesto div{font:400 1rem DM Sans;letter-spacing:0;margin-top:50px}footer{background:var(--blue);color:white;padding:40px 4vw;display:flex;justify-content:space-between}.app-shell{min-height:100vh}.topbar{position:sticky;top:0;background:#f4f0e7e8;backdrop-filter:blur(18px);border-bottom:1px solid #1b1b1b1a}.nav{display:flex;gap:5px}.nav a{display:flex;align-items:center;gap:7px;padding:9px 12px;border-radius:999px;font-size:.82rem}.nav a.active{background:var(--ink);color:white}.icon-button,.menu-button,.modal-close{border:0;background:transparent;cursor:pointer}.menu-button{display:none}.page{min-height:calc(100vh - 74px)}.content-wrap{padding:6vw 5vw 10vw;max-width:1500px;margin:auto}.page-heading{display:flex;align-items:end;justify-content:space-between;gap:40px;margin-bottom:60px}.page-heading h1,.login-card h1{font:800 clamp(3.2rem,7vw,7.5rem)/.88 Manrope;letter-spacing:-.075em;margin:14px 0}.page-heading h1 em,.login-card h1 em{font-style:normal;color:var(--blue)}.page-heading>p{max-width:430px;line-height:1.6}.page-heading.compact{margin-bottom:35px}.search-box{display:flex;align-items:center;gap:12px;max-width:620px;background:white;border-radius:18px;padding:0 18px;box-shadow:0 12px 35px #1a1b1910;margin-bottom:30px}.search-box input{width:100%;padding:18px 0;border:0;outline:0;background:transparent}.resource-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:16px}.resource-card{border:0;background:#fff;text-align:left;border-radius:24px;padding:24px;min-height:280px;cursor:pointer;transition:.3s transform,.3s box-shadow;animation:rise .5s calc(var(--i)*.06s) both}.resource-card:hover{transform:translateY(-7px);box-shadow:0 22px 55px #1112}.resource-icon{width:62px;height:62px;border-radius:20px;background:#e9edff;display:grid;place-items:center;margin-bottom:45px}.resource-card>p{font-size:.72rem;letter-spacing:.08em;color:#666}.resource-card h2{font:700 1.7rem Manrope;letter-spacing:-.04em}.meta{display:flex;justify-content:space-between;align-items:center;color:#60635f;font-size:.82rem}.meta span{display:flex;gap:5px;align-items:center}.meta svg{width:14px}.status{float:right;border-radius:99px;padding:6px 9px;background:#ecece8;font-size:.62rem;letter-spacing:.08em}.status.available,.status.confirmed{background:#d8f8ba;color:#255d11}.status.maintenance,.status.rejected{background:#ffd7d0;color:#8f1d09}.notice,.empty{padding:18px 20px;border-radius:16px;background:#fff;margin:18px 0}.empty{min-height:150px;display:grid;place-items:center;color:#666;border:1px dashed #bbb}.modal-backdrop{position:fixed;inset:0;background:#101210aa;z-index:50;display:grid;place-items:center;padding:20px}.booking-modal{position:relative;background:var(--cream);border-radius:28px;padding:36px;width:min(700px,100%);max-height:90vh;overflow:auto}.booking-modal h2{font:700 2.5rem Manrope;margin:12px 0}.modal-close{position:absolute;right:22px;top:22px}.form-grid{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin-top:25px}.form-grid label{font-size:.76rem;font-weight:600;letter-spacing:.04em}.form-grid input,.form-grid textarea,.form-grid select{display:block;width:100%;margin-top:7px;border:1px solid #d3d1c9;border-radius:12px;background:white;padding:13px}.form-grid textarea{min-height:90px;resize:vertical}.wide{grid-column:1/-1}.booking-list{display:grid;gap:10px}.booking-list article{display:grid;grid-template-columns:150px 1fr auto;gap:20px;align-items:center;background:white;padding:20px 24px;border-radius:18px}.booking-list article .status{float:none;width:max-content}.booking-list p{font-size:.7rem;letter-spacing:.1em;color:#777;margin:0}.booking-list h3{margin:5px 0}.booking-list time{font-size:.85rem;color:#555}.login-page{min-height:100vh;padding:30px 4vw;background:var(--blue);color:white}.login-card{background:var(--cream);color:var(--ink);width:min(600px,100%);margin:7vh auto 0;padding:clamp(28px,5vw,58px);border-radius:30px}.login-card h1{font-size:clamp(2.7rem,5vw,5rem)}@keyframes rise{from{opacity:0;transform:translateY(35px)}to{opacity:1;transform:none}}@keyframes float{50%{transform:translateY(-18px) rotate(8deg)}}
@media(max-width:850px){.categories{grid-template-columns:1fr}.category-card{min-height:330px}.page-heading{display:block}.nav{position:fixed;inset:70px 12px auto;background:#fff;padding:16px;border-radius:20px;box-shadow:0 20px 60px #0002;display:none;flex-direction:column}.nav.open{display:flex}.nav a{padding:13px}.menu-button{display:block}.logout{display:none}.resource-grid{grid-template-columns:1fr 1fr}.booking-list article{grid-template-columns:1fr}.orb-a{right:-30px}.orb-b{display:none}}
@media(max-width:560px){.text-link{display:none}.hero{min-height:820px}.hero h1{font-size:19vw;margin-top:13vh}.hero h1 .accent-line{padding-left:4vw}.hero-copy{margin:45px 0 0;width:85%}.grid-object{right:-30vw;bottom:0}.categories{padding:12px}.resource-grid{grid-template-columns:1fr}.content-wrap{padding:50px 18px}.page-heading h1{font-size:3.5rem}.form-grid{grid-template-columns:1fr}.form-grid label{grid-column:1}.topbar{padding:18px}.orb{width:90px;height:90px}.manifesto{padding:25vw 5vw}.booking-modal{padding:28px 20px}}
@media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;scroll-behavior:auto!important;transition-duration:.01ms!important}}

/* Four login choices arranged left to right */
.categories{grid-template-columns:repeat(4,minmax(0,1fr));gap:22px}
@media(max-width:1050px){.categories{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:560px){.categories{display:flex;overflow-x:auto;gap:16px;scroll-snap-type:x mandatory}.category-card{flex:0 0 82vw;scroll-snap-align:start}}

/* Match Classroom tile typography to Amenities */
.category-card.cobalt{color:var(--ink)}

/* Keep the hero background completely flat behind its headline */
.nothin-hero:after{background:none}

/* Studio-style hero, translated into original Book-It objects and content. */
.landing>.landing-nav{position:absolute;inset:0 0 auto;color:#f5f0e7}.landing>.landing-nav .brand i{color:#89a2ff}.landing>.landing-nav .pill{background:#f5f0e7;color:#111}.landing>.landing-nav .pill:hover{background:#d7ff49}.nothin-hero{height:100svh;min-height:720px;background:#0d0e0e;color:#f4f0e7;padding:0;isolation:isolate}.hero-center{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center;text-align:center;z-index:4}.hero-index{position:absolute;top:13%;font:500 .72rem Manrope;letter-spacing:.18em;color:#8d8f8c}.nothin-hero h1{display:flex;align-items:center;justify-content:center;font-size:clamp(6rem,18vw,18rem);line-height:.7;margin:0;letter-spacing:-.11em;white-space:nowrap}.nothin-hero h1 span{display:inline-block}.nothin-hero h1 .hero-mark{font-size:.46em;color:#315cff;margin:0 .08em;transform:translateY(.08em)}.hero-manifesto{font:500 clamp(.95rem,1.35vw,1.25rem)/1.25 Manrope;margin:8vh 0 2.5vh;letter-spacing:-.025em}.nothin-hero .hero-cta{position:static;border-bottom:1px solid #f4f0e7;padding:8px 0;gap:36px;font-size:.72rem;text-transform:uppercase;letter-spacing:.12em}.hero-rail{position:absolute;z-index:8;bottom:26px;font-size:.65rem;text-transform:uppercase;letter-spacing:.12em;display:flex;align-items:center;gap:8px}.hero-rail-left{left:4vw;flex-direction:column;align-items:flex-start;gap:2px}.hero-rail-right{right:4vw}.float-object{position:absolute;z-index:5;display:grid;place-items:center;filter:drop-shadow(0 24px 30px #0008);animation:drift 7s ease-in-out infinite;will-change:transform}.object-building{left:7vw;top:17%;width:150px;height:190px;background:linear-gradient(145deg,#456dff,#153bd4);border-radius:15px 42px 17px 25px;transform:rotate(-11deg);overflow:hidden}.object-building>svg{position:absolute;width:54px;height:54px;bottom:18px;right:16px}.building-face{display:grid;grid-template-columns:repeat(2,22px);gap:13px}.building-face i{width:22px;height:28px;background:#b8c5ff;border-radius:3px;box-shadow:inset 0 0 12px #fff8}.object-pin{right:11vw;top:16%;width:115px;height:115px;border-radius:52% 48% 55% 45%;background:#ff6d50;color:#111;transform:rotate(15deg);animation-delay:-1.2s}.object-pin svg{width:48px;height:48px}.object-clock{right:7vw;bottom:13%;width:175px;height:105px;background:#d7ff49;color:#10110f;border-radius:60px 21px 58px 35px;display:flex;gap:10px;transform:rotate(-8deg);animation-delay:-3s}.object-clock svg{width:27px}.object-clock b{font:700 1.15rem Manrope}.object-star{left:22vw;bottom:9%;width:95px;height:95px;background:linear-gradient(135deg,#ecebea,#767978);border-radius:28% 72% 35% 65%;color:#111;animation-delay:-4.5s}.object-star svg{width:42px;height:42px}.object-card{left:19vw;top:20%;width:125px;height:80px;background:#f4f0e7;color:#121312;border-radius:10px;padding:13px;display:flex;align-items:flex-start;flex-direction:column;transform:rotate(8deg);animation-delay:-2.2s}.object-card small{font-size:.48rem;letter-spacing:.15em}.object-card strong{font:800 1.4rem Manrope}.object-card span{margin-top:auto;font-size:.46rem;background:#bdf77b;border-radius:20px;padding:3px 6px}.chrome-loop{position:absolute;left:50%;top:8%;width:18vw;height:18vw;border:clamp(18px,3vw,45px) solid #242726;border-top-color:#8b8e8c;border-right-color:#474a49;border-radius:50%;transform:translateX(-50%) rotateX(67deg) rotateZ(-14deg);z-index:2;box-shadow:inset 0 0 20px #fff3,0 20px 50px #000;animation:loop 8s ease-in-out infinite}.nothin-hero:after{content:'';position:absolute;inset:0;z-index:1;background:radial-gradient(circle at 50% 48%,#292c2a 0,transparent 33%),linear-gradient(90deg,transparent 49.93%,#ffffff12 50%,transparent 50.07%);pointer-events:none}@keyframes drift{0%,100%{translate:0 0;rotate:0deg}50%{translate:0 -18px;rotate:3deg}}@keyframes loop{50%{transform:translateX(-50%) rotateX(62deg) rotateZ(8deg) scale(1.06)}}
@media(max-width:560px){.nothin-hero h1{font-size:25vw;margin:0;flex-wrap:wrap;max-width:100%;line-height:.6}.nothin-hero h1 .hero-mark{width:100%;height:.35em;line-height:.35}.hero-manifesto{margin-top:7vh}.hero-rail-right{display:none}.object-building{width:92px;height:118px;left:-18px;top:19%}.building-face{grid-template-columns:repeat(2,13px);gap:8px}.building-face i{width:13px;height:18px}.object-card{left:11vw;top:13%;width:100px;height:65px}.object-pin{width:76px;height:76px;right:-12px;top:20%}.object-clock{width:124px;height:72px;right:-14px;bottom:16%}.object-star{left:8vw;bottom:12%;width:68px;height:68px}.chrome-loop{width:47vw;height:47vw;top:9%}}

/* Book-It palette */
:root{--blue:#B81729;--cream:#F0EDE7;--coral:#B81729;background:#F0EDE7}body{background:#F0EDE7}.topbar{background:#F0EDE7e8}.landing>.landing-nav .brand i{color:#B81729}.nothin-hero h1 .hero-mark{color:#B81729}.object-building{background:linear-gradient(145deg,#D34B5B,#8F0F1F)}.building-face i{background:#F0EDE7}.object-pin{background:#B81729;color:#F0EDE7}.object-clock{background:#F0EDE7;color:#151716}.object-card{background:#F0EDE7}.object-card span{background:#B81729;color:#F0EDE7}.resource-icon{background:#F3DADD;color:#B81729}:focus-visible{outline-color:#B81729}

/* Brighter red accent */
:root{--blue:#D51F36;--coral:#D51F36}.landing>.landing-nav .brand i,.nothin-hero h1 .hero-mark{color:#D51F36}.object-building{background:linear-gradient(145deg,#ED5366,#A91224)}.object-pin,.object-card span{background:#D51F36}.resource-icon{background:#F8D8DC;color:#D51F36}:focus-visible{outline-color:#D51F36}

/* Cinematic classroom flow */
.room-finder,.booking-experience{background:#F0EDE7;min-height:100vh}.finder-hero{position:relative;min-height:66vh;padding:7vw 5vw 5vw;background:#111312;color:#F0EDE7;display:flex;align-items:flex-end;justify-content:space-between;overflow:hidden}.finder-hero h1,.booking-title h1{font:800 clamp(4rem,10vw,10rem)/.78 Manrope;letter-spacing:-.09em;margin:22px 0 0}.finder-hero h1 em,.booking-title h1 em{font-style:normal;color:#D51F36}.finder-hero>p{width:min(390px,32vw);line-height:1.6;position:relative;z-index:2}.finder-orbit{position:absolute;right:25%;top:10%;width:180px;height:180px;border:35px solid #D51F36;border-radius:50%;display:grid;place-items:center;animation:float 6s ease-in-out infinite}.finder-orbit svg{width:55px;height:55px}.finder-orbit span{position:absolute;right:-90px;top:35%;font:600 .6rem Manrope;letter-spacing:.16em}.finder-workspace{padding:5vw}.finder-form{display:grid;grid-template-columns:35px repeat(5,1fr) auto;gap:12px;align-items:end;background:#fff;border-radius:24px;padding:24px;box-shadow:0 20px 60px #22120f10}.finder-form label{font-size:.65rem;letter-spacing:.12em;text-transform:uppercase;font-weight:700}.finder-form label>div,.finder-form select{height:50px;margin-top:8px;border:1px solid #d9d4cd;border-radius:10px;display:flex;align-items:center;padding:0 12px;gap:8px;background:#fff}.finder-form input,.finder-form select{border:0;outline:0;width:100%;background:transparent}.finder-form select{border:1px solid #d9d4cd}.finder-form svg{width:17px;color:#D51F36}.field-number{align-self:center;color:#aaa;font:500 .65rem Manrope}.time-pair input{min-width:70px}.finder-submit,.booking-action,.confirm-action{border:0;background:#D51F36;color:#fff;border-radius:999px;padding:15px 20px;display:flex;align-items:center;justify-content:center;gap:10px;cursor:pointer;font-weight:700;white-space:nowrap}.finder-submit:disabled,.booking-action:disabled,.confirm-action:disabled{opacity:.4;cursor:not-allowed}.results-head{display:flex;justify-content:space-between;align-items:center;margin:60px 0 20px}.results-head>span{color:#666}.room-results{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.cinema-room-card{position:relative;min-height:310px;background:#fff;border:0;border-radius:22px;padding:24px;text-align:left;display:flex;flex-direction:column;cursor:pointer;animation:rise .6s calc(var(--i)*.07s) both;transition:.3s transform,.3s background}.cinema-room-card:hover{transform:translateY(-7px);background:#D51F36;color:#fff}.room-no{font:500 .65rem Manrope}.room-symbol{width:100px;height:100px;border-radius:50%;display:grid;place-items:center;background:#F8D8DC;margin:auto}.room-symbol svg{width:48px;height:48px;color:#D51F36}.cinema-room-card p{font-size:.6rem;letter-spacing:.12em}.cinema-room-card h2{font:800 2.5rem Manrope;margin:4px 0}.room-arrow{position:absolute;right:20px;bottom:20px}.finder-empty{height:240px;border:1px dashed #aaa;border-radius:22px;display:flex;align-items:center;justify-content:center;gap:30px}.finder-empty span{font:800 clamp(3rem,8vw,8rem) Manrope;color:#e5e0d9}.finder-empty p{max-width:280px}.booking-title{background:#111312;color:#F0EDE7;padding:5vw;position:relative}.back-link{background:none;border:0;color:#F0EDE7;display:flex;gap:8px;align-items:center;cursor:pointer;margin-bottom:7vh}.booking-context{position:absolute;right:5vw;bottom:5vw;display:grid;gap:8px;text-align:right;font:600 .65rem Manrope;letter-spacing:.12em}.slot-panel{padding:5vw}.slot-panel-head{display:flex;justify-content:space-between;align-items:end}.slot-panel-head h2,.hold-drawer h2{font:700 clamp(2rem,4vw,4rem)/.95 Manrope;letter-spacing:-.06em;margin:10px 0}.legend{display:flex;gap:18px;font-size:.72rem}.legend span{display:flex;align-items:center;gap:6px}.legend i{width:10px;height:10px;border-radius:50%;background:#fff;border:1px solid #aaa}.legend .occupied{background:#333}.legend .chosen{background:#D51F36;border-color:#D51F36}.booking-notice{margin:30px 0 0;padding:15px 18px;border-left:4px solid #D51F36;background:#fff}.slot-grid{display:grid;grid-template-columns:repeat(6,1fr);gap:10px;margin:35px 0}.slot-tile{min-height:180px;border:1px solid #d7d2ca;border-radius:16px;background:#fff;padding:15px;text-align:left;display:flex;flex-direction:column;cursor:pointer;transition:.25s}.slot-tile:hover:not(:disabled){transform:translateY(-5px);border-color:#D51F36}.slot-tile>span{font-size:.6rem;color:#888}.slot-tile strong{font:700 1.45rem Manrope;margin-top:auto}.slot-tile small{font-size:.6rem}.slot-tile b{font-size:.52rem;letter-spacing:.09em;margin-top:16px}.slot-tile.selected{background:#D51F36;color:#fff;border-color:#D51F36}.slot-tile.selected span{color:#fff}.slot-tile.unavailable{background:#292b2a;color:#aaa;border-color:#292b2a;cursor:not-allowed}.selection-bar{position:sticky;bottom:18px;background:#111312;color:#fff;border-radius:20px;padding:18px 20px;display:flex;align-items:center;justify-content:space-between;box-shadow:0 20px 60px #0004}.selection-bar>div{display:grid;gap:4px}.selection-bar span{font-size:.55rem;letter-spacing:.12em;color:#aaa}.hold-drawer{position:fixed;inset:auto 0 0;z-index:40;background:#D51F36;color:#fff;padding:28px 5vw;display:grid;grid-template-columns:220px 1fr;gap:40px;align-items:center;box-shadow:0 -20px 70px #0004}.timer-ring{width:170px;height:170px;border:1px solid #ffffff77;border-radius:50%;display:flex;flex-direction:column;align-items:center;justify-content:center}.timer-ring strong{font:800 2.5rem Manrope}.timer-ring span{font-size:.52rem;letter-spacing:.15em}.hold-drawer>div:last-child{display:grid;grid-template-columns:1fr 1fr;gap:12px;align-items:end}.hold-drawer h2,.hold-drawer>div>p{grid-column:1}.hold-drawer label{font-size:.62rem;letter-spacing:.1em}.hold-drawer input{display:block;margin-top:7px;width:100%;border:0;border-bottom:1px solid #fff;background:transparent;color:#fff;padding:10px 0;outline:0}.confirm-action{background:#F0EDE7;color:#151716}.success-stamp{position:fixed;right:30px;bottom:30px;background:#111312;color:#fff;border-radius:50%;width:130px;height:130px;display:flex;flex-direction:column;align-items:center;justify-content:center;animation:rise .5s both}.success-stamp span{font-size:.65rem;letter-spacing:.1em}
@media(max-width:1050px){.finder-form{grid-template-columns:30px 1fr 30px 1fr}.finder-submit{grid-column:1/-1}.room-results{grid-template-columns:1fr 1fr}.slot-grid{grid-template-columns:repeat(4,1fr)}}
@media(max-width:650px){.finder-hero{min-height:620px;display:block;padding:90px 20px 45px}.finder-hero>p{width:85%;margin-top:55px}.finder-orbit{right:-50px;top:28%;width:130px;height:130px;border-width:25px}.finder-workspace,.slot-panel{padding:45px 18px}.finder-form{grid-template-columns:25px 1fr}.finder-submit{grid-column:1/-1}.results-head,.slot-panel-head{display:block}.results-head span{display:block;margin-top:10px}.room-results{grid-template-columns:1fr}.booking-title{padding:35px 20px 50px}.booking-title h1{font-size:17vw}.booking-context{position:static;text-align:left;margin-top:40px}.legend{margin-top:24px;flex-wrap:wrap}.slot-grid{grid-template-columns:1fr 1fr}.slot-tile{min-height:150px}.selection-bar{bottom:8px;display:grid;gap:14px}.booking-action{width:100%}.hold-drawer{grid-template-columns:1fr;max-height:85vh;overflow:auto}.timer-ring{width:120px;height:120px}.hold-drawer>div:last-child{grid-template-columns:1fr}.hold-drawer h2,.hold-drawer>div>p{grid-column:1}.confirm-action{margin-top:10px}}

/* Canonical dashboard, hall and approvals UI */
.dashboard-hero,.event-hero,.approval-hero{background:#111312;color:#F0EDE7;padding:7vw 5vw 5vw;min-height:48vh;position:relative;overflow:hidden}.dashboard-hero h1,.event-hero h1,.approval-hero h1{font:800 clamp(4rem,9vw,9rem)/.8 Manrope;letter-spacing:-.09em;margin:30px 0}.dashboard-hero h1 em,.event-hero h1 em,.approval-hero h1 em{font-style:normal;color:#D51F36}.role-line{display:flex;gap:8px}.role-line span{border:1px solid #ffffff55;border-radius:99px;padding:7px 11px;font-size:.58rem;letter-spacing:.12em}.dashboard-body,.event-workspace,.approval-body{padding:5vw}.metric-row{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:-8vw;position:relative}.metric-row article{background:#fff;border-radius:20px;padding:22px;min-height:200px;display:flex;flex-direction:column}.metric-row article>span{font-size:.6rem}.metric-row strong{font:800 5rem Manrope;margin:auto 0}.metric-row p{font-size:.6rem;letter-spacing:.12em}.dashboard-grid{display:grid;grid-template-columns:1.3fr .7fr;gap:50px;margin-top:70px}.quick-grid{display:grid;gap:10px;margin-top:18px}.quick-grid button{border:0;background:#fff;border-radius:16px;padding:18px;display:grid;grid-template-columns:45px 1fr auto;align-items:center;text-align:left;cursor:pointer;transition:.25s}.quick-grid button:hover{background:#D51F36;color:#fff;transform:translateX(6px)}.quick-grid button>span{display:grid}.quick-grid button b{font:700 1.2rem Manrope}.quick-grid button span{font-size:.7rem}.notification-stack{display:grid;gap:8px;margin-top:18px}.notification-stack article{background:#fff;border-radius:15px;padding:16px;display:flex;gap:12px}.notification-stack svg{color:#D51F36}.notification-stack p{margin:0;font-size:.85rem}.notification-stack time{font-size:.62rem;color:#888}.event-disc{position:absolute;right:10vw;top:22%;width:160px;height:160px;border-radius:50%;background:#D51F36;display:flex;align-items:center;justify-content:center;gap:10px;animation:float 6s ease-in-out infinite}.event-disc span{font-size:.55rem;letter-spacing:.1em}.event-workspace{display:grid;grid-template-columns:.65fr 1.35fr;gap:8vw}.event-intro h2{font:700 clamp(2.5rem,5vw,5rem)/.9 Manrope;letter-spacing:-.065em}.event-intro>p:last-child{line-height:1.6;max-width:390px}.event-form{display:grid;grid-template-columns:1fr 1fr;gap:14px;background:#fff;border-radius:24px;padding:28px}.event-form label{font-size:.64rem;text-transform:uppercase;letter-spacing:.1em;font-weight:700}.event-form input,.event-form select,.event-form textarea{display:block;width:100%;border:0;border-bottom:1px solid #cfc9c1;background:transparent;padding:12px 0;margin-top:5px;outline:0}.event-form textarea{min-height:110px;resize:vertical}.event-submit{border:0;border-radius:99px;background:#D51F36;color:#fff;padding:16px 22px;display:flex;justify-content:space-between;cursor:pointer}.approval-list{display:grid;gap:12px}.approval-list>article{background:#fff;border-radius:20px;padding:24px;display:grid;grid-template-columns:60px 1fr 1.2fr;gap:20px;align-items:center}.approval-index{font:700 1rem Manrope;color:#aaa}.approval-list h2{font:700 2rem Manrope;margin:8px 0}.decision-box textarea{width:100%;border:1px solid #d5d0c8;border-radius:12px;padding:12px;resize:vertical}.decision-box>div{display:flex;gap:7px;margin-top:8px}.decision-box button{border:1px solid #d5d0c8;background:#F0EDE7;border-radius:99px;padding:8px 11px;display:flex;align-items:center;gap:5px;cursor:pointer}.decision-box button:first-child{background:#D51F36;color:#fff;border-color:#D51F36}
@media(max-width:800px){.metric-row{grid-template-columns:1fr;margin-top:-30px}.metric-row article{min-height:150px}.metric-row strong{font-size:3.5rem}.dashboard-grid,.event-workspace{grid-template-columns:1fr}.event-disc{width:100px;height:100px;right:-15px}.approval-list>article{grid-template-columns:1fr}.event-form{grid-template-columns:1fr}.event-form label{grid-column:1}.dashboard-body,.event-workspace,.approval-body{padding:45px 18px}.dashboard-hero,.event-hero,.approval-hero{padding:80px 20px 45px}}

/* Role-specific student and faculty event registration */
.ticket-page{min-height:100vh;background:#F0EDE7}.ticket-hero{min-height:55vh;background:#111312;color:#F0EDE7;padding:7vw 5vw 5vw;position:relative;overflow:hidden}.ticket-hero h1{font:800 clamp(4.5rem,10vw,10rem)/.78 Manrope;letter-spacing:-.09em;margin:30px 0}.ticket-hero h1 em{font-style:normal;color:#D51F36}.ticket-hero>svg{position:absolute;right:10vw;top:26%;width:150px;height:150px;color:#D51F36;transform:rotate(10deg);animation:float 5s ease-in-out infinite}.ticket-body{padding:5vw}.publish-form{background:#fff;border-radius:24px;padding:26px;display:grid;grid-template-columns:1.1fr repeat(2,1fr);gap:14px;margin-top:-9vw;position:relative}.publish-form h2,.ticket-heading h2{font:700 clamp(2rem,4vw,4rem)/.95 Manrope;letter-spacing:-.06em;margin:8px 0}.publish-form label{font-size:.62rem;text-transform:uppercase;letter-spacing:.1em;font-weight:700}.publish-form input,.publish-form select,.publish-form textarea{display:block;width:100%;border:0;border-bottom:1px solid #cfc9c1;padding:11px 0;background:transparent;outline:0}.publish-form textarea{min-height:70px}.ticket-heading{display:flex;align-items:end;justify-content:space-between;margin:70px 0 24px}.ticket-heading>span{font:.65rem Manrope;letter-spacing:.12em}.ticket-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.ticket-grid article{background:#fff;border-radius:22px;padding:24px;min-height:350px;display:flex;flex-direction:column;animation:rise .5s calc(var(--i)*.07s) both}.ticket-count{display:flex;align-items:baseline;gap:5px}.ticket-count strong{font:800 4rem Manrope}.ticket-count span{font-size:.55rem;letter-spacing:.1em}.ticket-grid h3{font:700 2rem/1 Manrope;letter-spacing:-.05em;margin:12px 0}.ticket-grid article>p:not(.kicker){color:#666;font-size:.8rem}.seat-meter{height:5px;background:#eee;border-radius:5px;margin:auto 0 20px;overflow:hidden}.seat-meter i{display:block;height:100%;background:#D51F36}.ticket-grid button,.ticket-hold button{border:0;background:#111312;color:#fff;border-radius:99px;padding:13px 16px;display:flex;align-items:center;justify-content:space-between;cursor:pointer}.ticket-hold{position:fixed;z-index:55;left:50%;bottom:25px;transform:translateX(-50%);width:min(720px,calc(100% - 28px));background:#D51F36;color:#fff;border-radius:24px;padding:18px 22px;display:grid;grid-template-columns:auto auto 1fr auto;gap:16px;align-items:center;box-shadow:0 20px 70px #0005}.ticket-hold>strong{font:800 2rem Manrope}.ticket-hold p{margin:0}.ticket-hold button{background:#F0EDE7;color:#111312}.applicant-table{display:grid;gap:7px;margin-top:25px}.applicant-table>div{display:grid;grid-template-columns:35px 1fr 1.4fr auto;gap:10px;align-items:center;border-bottom:1px solid #ddd;padding:12px 0}.applicant-table em{font-style:normal;font-size:.6rem;background:#F8D8DC;color:#A91224;padding:5px 8px;border-radius:99px}.applicant-table small{color:#666}
@media(max-width:800px){.ticket-hero{padding:85px 20px 50px}.ticket-hero>svg{width:85px;height:85px;right:-8px}.ticket-body{padding:45px 18px}.publish-form{grid-template-columns:1fr;margin-top:-70px}.publish-form>*{grid-column:1}.ticket-grid{grid-template-columns:1fr}.ticket-heading{display:block}.ticket-hold{grid-template-columns:auto 1fr}.ticket-hold>div{grid-column:1/-1}.ticket-hold button{grid-column:1/-1}.applicant-table>div{grid-template-columns:30px 1fr}.applicant-table small,.applicant-table em{grid-column:2}}

/* Final hero surface: solid dark, with no light or glow layer */
.nothin-hero{background:#0d0e0e!important;background-image:none!important}
.nothin-hero:before,.nothin-hero:after{content:none!important;display:none!important;background:none!important;box-shadow:none!important}
.nothin-hero h1,.nothin-hero .hero-center{text-shadow:none!important;filter:none!important}


/* Room finder: corrected form layout */
.finder-form{
  display:grid;
  grid-template-columns:repeat(3,minmax(0,1fr));
  grid-template-areas:
    "date time people"
    "block block submit";
  gap:24px 20px;
  align-items:end;
}
.finder-date{grid-area:date}
.finder-time{grid-area:time}
.finder-people{grid-area:people}
.finder-block{grid-area:block;width:100%;max-width:none}
.finder-field{
  display:grid;
  grid-template-columns:28px minmax(0,1fr);
  align-items:end;
  gap:12px;
  min-width:0;
}
.finder-field .field-number{
  align-self:end;
  padding-bottom:20px;
}
.finder-field label{
  display:block;
  min-width:0;
  width:100%;
}
.finder-field label>div{
  width:100%;
  min-width:0;
}
.finder-field label>div,
.finder-field select{
  height:60px;
  margin-top:10px;
}
.finder-field select{
  display:block;
  width:100%;
  padding:0 16px;
  border:1px solid #d9d4cd;
  border-radius:12px;
  background:#fff;
}
.finder-field .time-pair{
  gap:10px;
}
.finder-field .time-pair input{
  min-width:0;
}
.finder-submit{
  grid-area:submit;
  justify-self:end;
  align-self:end;
  width:min(100%,360px);
  min-height:60px;
  padding:18px 26px;
  border-radius:999px;
  font-size:1rem;
}
@media(max-width:1050px){
  .finder-form{
    grid-template-columns:repeat(2,minmax(0,1fr));
    grid-template-areas:
      "date time"
      "people people"
      "block block"
      "submit submit";
  }
  .finder-submit{
    justify-self:end;
    width:min(100%,360px);
  }
}
@media(max-width:650px){
  .finder-form{
    grid-template-columns:minmax(0,1fr);
    grid-template-areas:
      "date"
      "time"
      "people"
      "block"
      "submit";
    gap:20px;
  }
  .finder-submit{
    justify-self:stretch;
    width:100%;
  }
}

/* Fix spacing between booking status and purpose */
.booking-list article {
  grid-template-columns: 280px minmax(0, 1fr) auto;
  column-gap: 24px;
}

.booking-list article .status {
  float: none;
  width: max-content;
  max-width: 100%;
  justify-self: start;
}

@media (max-width: 850px) {
  .booking-list article {
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }

  .booking-list article .status {
    width: max-content;
  }
}

/* Fix event proposal detail label/value overlap */
.proposal-details {
  width: 100%;
  min-width: 0;
}

.proposal-details > div {
  display: grid;
  grid-template-columns: minmax(140px, 0.7fr) minmax(0, 1.3fr);
  align-items: start;
  gap: 16px;
  padding: 16px 0;
  border-bottom: 1px solid #ddd;
  min-width: 0;
}

.proposal-details > div > b {
  min-width: 0;
  overflow-wrap: anywhere;
  text-transform: capitalize;
}

.proposal-details > div > small {
  min-width: 0;
  color: #666;
  font-size: 0.95rem;
  line-height: 1.6;
  overflow-wrap: anywhere;
  white-space: pre-wrap;
}

@media (max-width: 560px) {
  .proposal-details > div {
    grid-template-columns: minmax(0, 1fr);
    gap: 6px;
  }
}

/* Subtle red secondary action for approval history */
.btn-history {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 10px 16px;
  border: 1px solid rgba(220, 25, 55, 0.25);
  border-radius: 999px;
  background: rgba(220, 25, 55, 0.06);
  color: #c91836;
  font: inherit;
  font-size: 0.9rem;
  font-weight: 500;
  cursor: pointer;
  transition: background 0.2s ease, border-color 0.2s ease;
}

.btn-history:hover {
  background: rgba(220, 25, 55, 0.12);
  border-color: rgba(220, 25, 55, 0.45);
}

.btn-history:focus-visible {
  outline: 2px solid #dc1937;
  outline-offset: 3px;
}


.dashboard-body {
  display: flex;
  flex-direction: column;
  gap: 28px;
  min-width: 0;
}

.role-workflow-card {
  position: relative;
  min-width: 0;
  overflow-wrap: anywhere;
}

.metric-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 16px;
  width: 100%;
  min-width: 0;
  align-items: stretch;
}

.metric-card {
  appearance: none;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  width: 100%;
  min-width: 0;
  min-height: 250px;
  padding: 28px;
  border: 1px solid transparent;
  border-radius: 28px;
  background: #fff;
  color: #171717;
  font: inherit;
  text-align: left;
  overflow-wrap: anywhere;
}

button.metric-card {
  cursor: pointer;
  transition: transform 160ms ease, border-color 160ms ease, box-shadow 160ms ease;
}

button.metric-card:hover {
  transform: translateY(-3px);
  border-color: #d9d5ce;
  box-shadow: 0 12px 30px rgba(0, 0, 0, 0.06);
}

button.metric-card:focus-visible {
  outline: 3px solid #171717;
  outline-offset: 3px;
}

.metric-card > span {
  font-size: 14px;
}

.metric-card > strong {
  display: block;
  max-width: 100%;
  font-size: clamp(64px, 7vw, 112px);
  line-height: 0.95;
  letter-spacing: -0.06em;
}

.metric-card > p {
  margin: 0;
  max-width: 100%;
  font-size: 13px;
  letter-spacing: 0.12em;
  overflow-wrap: anywhere;
}

.metric-card > small {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #666;
}

.metric-card-static {
  cursor: default;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 28px;
  min-width: 0;
}

.metric-modal-backdrop {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 20px;
  background: rgba(20, 20, 20, 0.48);
  backdrop-filter: blur(4px);
}

.metric-modal {
  width: min(620px, 100%);
  max-height: min(80vh, 760px);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  border-radius: 24px;
  background: #f7f5f0;
  color: #171717;
  box-shadow: 0 24px 80px rgba(0, 0, 0, 0.22);
}

.metric-modal-header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
  padding: 24px 26px;
  border-bottom: 1px solid #e4e0d8;
}

.metric-modal-header h2 {
  margin: 8px 0 0;
  font-size: clamp(24px, 4vw, 34px);
  line-height: 1.1;
}

.metric-modal-close {
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  width: 40px;
  height: 40px;
  border: 0;
  border-radius: 50%;
  background: #e9e6df;
  color: #171717;
  cursor: pointer;
}

.metric-modal-list {
  display: grid;
  gap: 12px;
  padding: 20px 26px;
  overflow-y: auto;
}

.metric-modal-item {
  padding: 18px;
  border: 1px solid #e4e0d8;
  border-radius: 16px;
  background: #fff;
}

.metric-modal-item h3 {
  margin: 12px 0 8px;
  font-size: 20px;
}

.metric-modal-item p {
  margin: 6px 0;
  color: #555;
  overflow-wrap: anywhere;
}

.metric-modal-empty {
  padding: 28px 26px;
  color: #555;
}

.metric-modal-footer {
  display: flex;
  justify-content: flex-end;
  padding: 16px 26px 24px;
  border-top: 1px solid #e4e0d8;
}

@media (max-width: 900px) {
  .metric-row {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .dashboard-grid {
    grid-template-columns: minmax(0, 1fr);
  }
}

@media (max-width: 600px) {
  .metric-row {
    grid-template-columns: minmax(0, 1fr);
  }

  .metric-card {
    min-height: 200px;
    padding: 24px;
  }

  .metric-modal-backdrop {
    padding: 12px;
  }

  .metric-modal {
    max-height: 88vh;
    border-radius: 18px;
  }

  .metric-modal-header,
  .metric-modal-list,
  .metric-modal-footer {
    padding-left: 18px;
    padding-right: 18px;
  }
}


.dashboard-page {
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.dashboard-hero {
  margin-bottom: 48px;
  position: relative;
  z-index: 1;
}

.dashboard-body {
  display: flex;
  flex-direction: column;
  gap: 32px;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
}

.role-workflow-card {
  position: relative;
  z-index: 1;
  width: 100%;
  min-width: 0;
  box-sizing: border-box;
  margin: 0;
  padding: 32px;
  overflow-wrap: anywhere;
}

.role-workflow-card h2 {
  margin: 12px 0;
  line-height: 1.2;
}

.role-workflow-card > p:not(.kicker) {
  margin: 0;
  line-height: 1.65;
}

.metric-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
  width: 100%;
  min-width: 0;
  margin: 0;
}

.metric-row > article {
  position: relative;
  min-width: 0;
  min-height: 250px;
  box-sizing: border-box;
  padding: 30px;
  overflow-wrap: anywhere;
}

.metric-row > article strong {
  display: block;
  margin: 24px 0;
  line-height: 1;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 28px;
  width: 100%;
  min-width: 0;
  margin-top: 8px;
}

.dashboard-grid > div {
  min-width: 0;
}

@media (max-width: 900px) {
  .metric-row {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .dashboard-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 560px) {
  .metric-row {
    grid-template-columns: 1fr;
  }

  .role-workflow-card,
  .metric-row > article {
    padding: 22px;
  }

  .metric-row > article {
    min-height: 190px;
  }
}


.dashboard-page,
.dashboard-page * {
  box-sizing: border-box;
}

.dashboard-hero {
  margin-bottom: 44px;
}

.dashboard-body {
  display: flex;
  flex-direction: column;
  gap: 30px;
  min-width: 0;
}

.role-workflow-card {
  position: relative;
  margin: 0;
  padding: 30px;
  width: 100%;
  min-width: 0;
  overflow-wrap: anywhere;
}

.role-workflow-card h2 {
  margin: 12px 0;
  line-height: 1.2;
}

.role-workflow-card > p:not(.kicker) {
  line-height: 1.65;
}

.metric-row {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 20px;
  width: 100%;
  min-width: 0;
  margin: 0;
}

.dashboard-metric-card {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 0;
  min-width: 0;
  min-height: 280px;
  width: 100%;
  padding: 30px;
  border: 1px solid transparent;
  border-radius: 28px;
  background: #fff;
  color: #171717;
  text-align: left;
  font: inherit;
  cursor: pointer;
  transition: transform 160ms ease, box-shadow 160ms ease, border-color 160ms ease;
}

.dashboard-metric-card:hover {
  transform: translateY(-3px);
  box-shadow: 0 12px 32px rgb(0 0 0 / 7%);
  border-color: #dedbd5;
}

.dashboard-metric-card:focus-visible {
  outline: 3px solid #777;
  outline-offset: 3px;
}

.metric-index {
  font-size: 14px;
}

.dashboard-metric-card strong {
  display: block;
  margin: 34px 0 26px;
  font-size: clamp(52px, 6vw, 100px);
  line-height: 0.95;
  font-weight: 650;
}

.metric-label {
  font-size: 13px;
  letter-spacing: 0.12em;
  line-height: 1.5;
}

.metric-link {
  display: flex;
  align-items: center;
  gap: 8px;
  margin-top: auto;
  padding-top: 18px;
  color: #666;
  font-size: 14px;
}

.dashboard-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 28px;
  width: 100%;
  min-width: 0;
  margin-top: 0;
}

.dashboard-grid > div {
  min-width: 0;
}

.dashboard-details-modal {
  width: min(760px, calc(100vw - 32px));
  max-width: 760px;
  max-height: min(82vh, 850px);
  overflow-y: auto;
  position: relative;
  padding: 32px;
}

.dashboard-details-modal h2 {
  margin: 12px 0;
  padding-right: 32px;
  overflow-wrap: anywhere;
}

.dashboard-modal-list {
  display: flex;
  flex-direction: column;
  gap: 14px;
  margin: 24px 0;
}

.dashboard-detail-item {
  min-width: 0;
  padding: 20px;
  border: 1px solid #e8e5df;
  border-radius: 16px;
  overflow-wrap: anywhere;
}

.dashboard-detail-item h3 {
  margin: 14px 0 8px;
}

.dashboard-detail-item > p {
  margin: 6px 0;
  line-height: 1.5;
}

.dashboard-detail-line {
  color: #5e5e5e;
  font-size: 14px;
}

@media (max-width: 900px) {
  .metric-row {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .dashboard-grid {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 560px) {
  .metric-row {
    grid-template-columns: 1fr;
  }

  .dashboard-metric-card {
    min-height: 210px;
    padding: 24px;
  }

  .role-workflow-card,
  .dashboard-details-modal {
    padding: 22px;
  }
}
